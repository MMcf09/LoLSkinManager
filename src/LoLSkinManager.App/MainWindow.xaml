<Window x:Class="LoLSkinManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Skin Manager" Height="800" Width="1240"
        MinHeight="680" MinWidth="1020"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#242A35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkinCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="#111722" CornerRadius="22" ClipToBounds="True" BorderBrush="#283141" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#C89B3C"/>
                                <Setter TargetName="CardBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="CardBorder" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.015" ScaleY="1.015"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#151A23" CornerRadius="24" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LoL Skin Manager" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="Catálogo visual + biblioteca local de custom skins" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock x:Name="CatalogStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Carregando catálogo..."/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Catálogo">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="24" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#10151E" CornerRadius="14" Padding="2">
                                <TextBox x:Name="ChampionSearchBox" Height="40" Padding="12,7" BorderThickness="0" Background="Transparent" Foreground="White" TextChanged="ChampionSearchBox_TextChanged" ToolTip="Buscar campeão"/>
                            </Border>
                            <ListBox x:Name="ChampionsList" Grid.Row="2" SelectionChanged="ChampionsList_SelectionChanged" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14" Padding="8" Margin="2,4" Background="#111722">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True">
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="24" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedChampionText" Text="Selecione um campeão" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SkinCountText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SkinsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SkinCardButton}" Width="268" Margin="0,0,14,14" Tag="{Binding}" Click="SkinCard_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="154"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Image Source="{Binding SplashUrl}" Stretch="UniformToFill"/>
                                                    <Border Grid.Row="1" Background="#111722" Padding="14,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding ChromaLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#242A35" CornerRadius="10" Padding="9,5" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <TextBlock Text="Selecionar" FontSize="11" Foreground="#EACD8E"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Meus pacotes">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource RoundedButton}" Content="Abrir pasta" Click="OpenFolder_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource RoundedButton}" Content="Importar pacote" Click="Import_Click" Background="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="24" Padding="18">
                        <Grid>
                            <ListView x:Name="PackagesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Status}"/>
                                        <GridViewColumn Header="Importado em" Width="180" DisplayMemberBinding="{Binding ImportedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                        <GridViewColumn Header="Arquivo" Width="400" DisplayMemberBinding="{Binding FilePath}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="EmptyState" Text="Nenhum pacote importado ainda." Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#151A23" CornerRadius="18" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="O app organiza e seleciona pacotes localmente; não injeta código nem altera a memória do jogo."/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource RoundedButton}" Content="Ativar/Desativar" Click="Toggle_Click" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource RoundedButton}" Content="Remover" Click="Remove_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
