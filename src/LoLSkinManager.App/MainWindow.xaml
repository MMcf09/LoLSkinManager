<Window x:Class="LoLSkinManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Skin Manager" Height="660" Width="980"
        MinHeight="560" MinWidth="820"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LoL Skin Manager" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Biblioteca local de pacotes de custom skins" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Abrir pasta" Click="OpenFolder_Click" Padding="14,8" Margin="0,0,10,0"/>
                <Button Content="Importar pacote" Click="Import_Click" Padding="16,8" Background="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
            <Grid>
                <ListView x:Name="PackagesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="Importado em" Width="180" DisplayMemberBinding="{Binding ImportedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                            <GridViewColumn Header="Arquivo" Width="240" DisplayMemberBinding="{Binding FilePath}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyState"
                           Text="Nenhum pacote importado ainda."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       Text="O app organiza seus pacotes localmente; não injeta código nem altera a memória do jogo."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Ativar/Desativar" Click="Toggle_Click" Padding="14,8" Margin="0,0,10,0"/>
                <Button Content="Remover" Click="Remove_Click" Padding="14,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
