<Window x:Class="LoLSkinManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Skin Manager" Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LoL Skin Manager" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Catálogo visual + biblioteca local de custom skins" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CatalogStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Carregando catálogo..."/>
        </Grid>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Catálogo">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ChampionSearchBox" Height="36" Padding="10,6" TextChanged="ChampionSearchBox_TextChanged" ToolTip="Buscar campeão"/>
                            <ListBox x:Name="ChampionsList" Grid.Row="2" SelectionChanged="ChampionsList_SelectionChanged" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedChampionText" Text="Selecione um campeão" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SkinCountText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SkinsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="250" Margin="0,0,12,12" Background="#10131A" CornerRadius="10" ClipToBounds="True">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="140"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Image Source="{Binding SplashUrl}" Stretch="UniformToFill"/>
                                                    <StackPanel Grid.Row="1" Margin="12">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ChromaLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Meus pacotes">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Abrir pasta" Click="OpenFolder_Click" Padding="14,8" Margin="0,0,10,0"/>
                        <Button Content="Importar pacote" Click="Import_Click" Padding="16,8" Background="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
                        <Grid>
                            <ListView x:Name="PackagesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Status}"/>
                                        <GridViewColumn Header="Importado em" Width="180" DisplayMemberBinding="{Binding ImportedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                        <GridViewColumn Header="Arquivo" Width="360" DisplayMemberBinding="{Binding FilePath}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="EmptyState" Text="Nenhum pacote importado ainda." Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="O app organiza seus pacotes localmente; não injeta código nem altera a memória do jogo."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Ativar/Desativar" Click="Toggle_Click" Padding="14,8" Margin="0,0,10,0"/>
                            <Button Content="Remover" Click="Remove_Click" Padding="14,8"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
