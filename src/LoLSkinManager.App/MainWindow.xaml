<Window x:Class="LoLSkinManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Skin Manager" Height="840" Width="1320"
        MinHeight="720" MinWidth="1060"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FC"/>
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="BorderBrush" Value="#344052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2B3545"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#C89B3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkinCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F7F9FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="#10151E" CornerRadius="22" ClipToBounds="True" BorderBrush="#283447" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#C89B3C"/>
                                <Setter TargetName="Card" Property="Background" Value="#151C27"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121823" CornerRadius="24" Padding="22" BorderBrush="#263041" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LoL Skin Manager" FontSize="32" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Catálogo visual + biblioteca local de custom skins" Foreground="#C7CFDC" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0D121A" CornerRadius="14" Padding="12,8" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="CatalogStatusText" Foreground="#D6DEEA" Text="Carregando catálogo..." HorizontalAlignment="Right"/>
                            <TextBlock x:Name="DownloadAllStatusText" Foreground="#AEB9C9" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" Text="Pacotes remotos: não verificado"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="DownloadAllButton"
                            Style="{StaticResource ActionButton}"
                            Content="Baixar todos os .fantome"
                            Click="DownloadAll_Click"
                            Background="#6D5422"
                            BorderBrush="#C89B3C"
                            ToolTip="Baixa de uma vez todos os pacotes .fantome cadastrados em skins/index.json"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Catálogo">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#141923" CornerRadius="24" Padding="14" BorderBrush="#263041" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#0D121A" CornerRadius="14" BorderBrush="#2A3547" BorderThickness="1" Padding="4">
                                <TextBox x:Name="ChampionSearchBox" Height="40" Padding="12,7" BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF" TextChanged="ChampionSearchBox_TextChanged" ToolTip="Buscar campeão"/>
                            </Border>
                            <ListBox x:Name="ChampionsList" Grid.Row="2" SelectionChanged="ChampionsList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True"><Image Source="{Binding IconUrl}" Stretch="UniformToFill"/></Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Title}" Foreground="#B9C3D2" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#141923" CornerRadius="24" Padding="20" BorderBrush="#263041" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedChampionText" Text="Selecione um campeão" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="SkinCountText" Foreground="#C7CFDC" Margin="0,5,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SkinsItemsControl">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SkinCardButton}" Width="276" Margin="0,0,14,14" Tag="{Binding}" Click="SkinCard_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="158"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Image Source="{Binding SplashUrl}" Stretch="UniformToFill"/>
                                                    <Border Grid.Row="1" Background="#10151E" Padding="14,13">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding ChromaLabel}" Foreground="#BBC5D4" FontSize="11" Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#2A2113" BorderBrush="#6D5422" BorderThickness="1" CornerRadius="10" Padding="9,5" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <TextBlock Text="Selecionar" FontSize="11" Foreground="#FFE5A8" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Meus pacotes">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButton}" Content="Abrir pasta" Click="OpenFolder_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ActionButton}" Content="Importar pacote" Click="Import_Click" Background="#6D5422" BorderBrush="#C89B3C"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#141923" CornerRadius="24" Padding="18" BorderBrush="#263041" BorderThickness="1">
                        <Grid>
                            <ListView x:Name="PackagesList" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF">
                                <ListView.View><GridView>
                                    <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="Importado em" Width="180" DisplayMemberBinding="{Binding ImportedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                    <GridViewColumn Header="Arquivo" Width="420" DisplayMemberBinding="{Binding FilePath}"/>
                                </GridView></ListView.View>
                            </ListView>
                            <TextBlock x:Name="EmptyState" Text="Nenhum pacote importado ainda." Foreground="#B9C3D2" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Background="#121823" CornerRadius="18" Padding="14" BorderBrush="#263041" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="#C7CFDC" Text="O app organiza e seleciona pacotes localmente; não injeta código nem altera a memória do jogo."/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource ActionButton}" Content="Ativar/Desativar" Click="Toggle_Click" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource ActionButton}" Content="Remover" Click="Remove_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
